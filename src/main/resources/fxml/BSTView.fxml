<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.ui.controllers.BSTController"
            stylesheets="@../styles/styles.css">

    <top>
        <HBox alignment="CENTER" style="-fx-padding: 15; -fx-background-color: white; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 0, 5, 0, 0);">
            <Label text="Visualisasi Binary Search Tree" styleClass="header-label"/>
        </HBox>
    </top>

    <center>
        <Pane fx:id="visualizerPane" styleClass="visualizer-pane" style="-fx-background-color: #fafafa;"/>
    </center>

    <right>
        <VBox spacing="15" styleClass="sidebar-container" prefWidth="250">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <Label text="Hasil Traversal" styleClass="sidebar-title"/>
            <Separator />

            <VBox styleClass="result-card">
                <Label text="PreOrder (Root-Left-Right)" styleClass="result-label-title"/>
                <Label fx:id="preOrderLabel" text="-" styleClass="result-value" wrapText="true"/>
            </VBox>

            <VBox styleClass="result-card">
                <Label text="InOrder (Left-Root-Right)" styleClass="result-label-title"/>
                <Label fx:id="inOrderLabel" text="-" styleClass="result-value" wrapText="true"/>
            </VBox>

            <VBox styleClass="result-card">
                <Label text="PostOrder (Left-Right-Root)" styleClass="result-label-title"/>
                <Label fx:id="postOrderLabel" text="-" styleClass="result-value" wrapText="true"/>
            </VBox>
        </VBox>
    </right>

    <bottom>
        <HBox alignment="CENTER" spacing="15" style="-fx-padding: 20; -fx-background-color: white;">
            <TextField fx:id="inputField" promptText="Masukkan Angka" prefWidth="200" styleClass="text-field"/>
            <Button text="Insert Node" onAction="#onInsert" styleClass="button"/>
            <Button text="Kembali" onAction="#onBack" styleClass="button, button-danger"/>
        </HBox>
    </bottom>
</BorderPane>