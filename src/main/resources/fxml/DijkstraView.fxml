<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.ui.controllers.DijkstraController"
            stylesheets="@../styles/styles.css">

    <top>
        <HBox alignment="CENTER" style="-fx-padding: 15; -fx-background-color: white;">
            <Label text="Visualisasi Algoritma Dijkstra" styleClass="header-label"/>
        </HBox>
    </top>

    <center>
        <Pane fx:id="graphPane" styleClass="visualizer-pane" style="-fx-background-color: #fafafa;"/>
    </center>

    <right>
        <VBox spacing="15" styleClass="sidebar-container" prefWidth="280">
            <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

            <Label text="Kontrol Graf" styleClass="sidebar-title"/>
            <Separator />

            <Label text="1. Buat Node" style="-fx-font-weight:bold"/>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <TextField fx:id="nodeCountField" prefWidth="60" promptText="Jml"/>
                <Button text="Reset Graph" onAction="#onCreateGraph" styleClass="button"/>
            </HBox>

            <Separator />

            <Label text="2. Tambah Edge (Jalur)" style="-fx-font-weight:bold"/>
            <HBox spacing="5" alignment="CENTER_LEFT" fx:id="edgeInputBox" disable="true">
                <TextField fx:id="sourceField" promptText="Asal" prefWidth="50"/>
                <TextField fx:id="destField" promptText="Tujuan" prefWidth="50"/>
                <TextField fx:id="weightField" promptText="Berat" prefWidth="50"/>
            </HBox>
            <Button text="Tambah Jalur" onAction="#onAddEdge" maxWidth="Infinity" styleClass="button"/>

            <Separator />

            <Label text="3. Cari Rute Terpendek" style="-fx-font-weight:bold"/>
            <HBox spacing="10" alignment="CENTER_LEFT" fx:id="actionBox" disable="true">
                <TextField fx:id="startNodeField" promptText="Start" prefWidth="60"/>
                <TextField fx:id="targetNodeField" promptText="End" prefWidth="60"/>
            </HBox>
            <Button text="Jalankan Dijkstra" onAction="#onSolve" maxWidth="Infinity" styleClass="button"/>

            <Label fx:id="statusLabel" text="Status: Siap" wrapText="true" style="-fx-text-fill: #555; -fx-padding: 10 0 0 0;"/>
        </VBox>
    </right>

    <bottom>
        <HBox alignment="CENTER" style="-fx-padding: 15; -fx-background-color: white;">
            <Button text="Kembali ke Menu Utama" onAction="#onBack" styleClass="button, button-danger"/>
        </HBox>
    </bottom>
</BorderPane>